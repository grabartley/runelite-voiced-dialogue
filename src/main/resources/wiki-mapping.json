{
  "_comment": "Single source for the wiki-text mappings shared by tools/generate_npc_voices.py and the runtime auto-learn lookup. Race rules are ordered, first match wins, and are matched case-insensitively against the infobox race field. Category rules are ordered substring matches against a page's joined category titles, used when the infobox carries no race. Buckets are voice-categorical, not lore-accurate: gnome -> Gnome, ogre/cyclops -> Troll, vampyre -> Undead, dragon/TzHaar -> Demon.",
  "defaultRace": "Human",
  "defaultGender": "Male",
  "femaleGender": "Female",
  "raceRules": [
    {"pattern": "citizens? of arceuus", "race": "Arceuus"},
    {"pattern": "\\baranei\\b", "race": "Aranei"},
    {"pattern": "vampyre|vampire|\\bvyre\\b|zombie|skeleton|ghost|ghoul|undead|wight|shade|revenant|mummy|banshee|spectre|wraith|ankou|lich|reanimat", "race": "Undead"},
    {"pattern": "demon|devil|\\bimp\\b|abyssal|dragon|wyvern|wyrm|drake|tzhaar|tztok|tzkal|hellhound", "race": "Demon"},
    {"pattern": "\\bdogs?\\b", "race": "Dog"},
    {"pattern": "\\bcrabs?\\b", "race": "Crab"},
    {"pattern": "\\bpenguins?\\b", "race": "Penguin"},
    {"pattern": "gnome", "race": "Gnome"},
    {"pattern": "goblin|hobgoblin", "race": "Goblin"},
    {"pattern": "dwarf|dwarven", "race": "Dwarf"},
    {"pattern": "\\belf\\b|\\belves\\b|elven|gnome elf", "race": "Elf"},
    {"pattern": "troll|\\bgiant\\b|cyclops|ogre|\\bent\\b|\\bgolem\\b|\\bhuman.*giant", "race": "Troll"},
    {"pattern": "gorilla", "race": "Gorilla"},
    {"pattern": "monkey|primate|baboon|mandril", "race": "Monkey"},
    {"pattern": "(?<!half )(?<!half-)icyene", "race": "Icyene"},
    {"pattern": "tortugan|tortuga", "race": "Tortugan"},
    {"pattern": "\\bhuman\\b|\\bman\\b|\\bwoman\\b|\\bgnome child\\b", "race": "Human"}
  ],
  "categoryRaceRules": [
    {"keyword": "citizens of arceuus", "race": "Arceuus"},
